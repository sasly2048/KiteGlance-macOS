# KiteGlance environment configuration.
#
# Copy this file to `.env` and uncomment any variable you want to set.
# `.env` is read at launch time; changes after launch do not take effect
# until the app is restarted.

# Enable verbose logging. Off by default; on means Log.shared writes
# every entry at .debug level to ~/Library/Application Support/KiteGlance/logs/kiteglance.log
KITEGLANCE_DEBUG=0

# Write a JSONL log alongside the human-readable one. Off by default;
# on means every entry is also written to ~/Library/Application Support/KiteGlance/logs/kiteglance.jsonl
# with a structured {template, properties, level, timestamp} record.
# Useful when a user reports a specific failure mode and the only
# evidence is the live log.
KITEGLANCE_STRUCTURED_LOG=0
